<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest of the Microsoft Store package. scripts/build-msix.ps1 fills the placeholders in double braces:
    IdentityName, Publisher, PublisherDisplayName  from Partner Center, "Product management > Product identity"
                                                   (the defaults are for local testing only and are refused by the Store)
    Version                                        four parts; the Store reserves the last one, so it is x.y.z.0
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{{IdentityName}}" Publisher="{{Publisher}}" Version="{{Version}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>FloatDock</DisplayName>
    <PublisherDisplayName>{{PublisherDisplayName}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ru-ru" />
  </Resources>

  <Applications>
    <Application Id="FloatDock" Executable="FloatDock.App.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="FloatDock"
        Description="A floating dock for the Windows desktop"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows" in Settings: the packaged app cannot use the Run key, it uses this task. Off until the user asks. -->
        <desktop:Extension Category="windows.startupTask" Executable="FloatDock.App.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="FloatDockStartup" Enabled="false" DisplayName="FloatDock" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The dock is a classic desktop (Win32) process: it enumerates windows, registers an AppBar, hooks window events and
         launches other programs. Store apps with this capability go through the extra review for full-trust apps. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
